from flask import Flask, request, render_template_string

app = Flask(__name__)

HTML = """
<!DOCTYPE html>
<html lang="om">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Karoora Mana Dhuunfaa</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 650px;
            margin: auto;
            background: white;
            padding: 22px;
            border-radius: 12px;
        }
        h1 { color: #166534; text-align: center; }

label { display: block; margin-top: 14px; }
        input {
            width: 100%;
            box-sizing: border-box;
            padding: 11px;
            margin-top: 6px;
        }
        button {
            width: 100%;
            padding: 12px;
            margin-top: 18px;
            background: #166534;
color: white;
            border: none;
            border-radius: 6px;
        }
        .result {
            margin-top: 20px;
            padding: 15px;
            background: #ecfdf5;
            border-radius: 8px;
        }
    </style>
</head>
<body>
<div class="container">
    <h1>Karoora Mana Dhuunfaa</h1>
    <p>Odeeffannoo baajata mana ijaaruuf barbaachisu galchi.</p>

    <form method="POST">
        <label>Maqaa Abbaa Manaa</label>
        <input name="maqaa" required>

        <label>Baajata waliigalaa (Birrii)</label>
        <input type="number" name="baajata"
               min="0" step="0.01" required>

        <label>Baasii meeshaalee ijaarsaa (Birrii)</label>
        <input type="number" name="meeshaa"
min="0" step="0.01" required>

        <label>Baasii hojjettootaa (Birrii)</label>
        <input type="number" name="hojjetaa"
               min="0" step="0.01" required>

        <label>Baasii biroo (Birrii)</label>
        <input type="number" name="biroo"
               min="0" step="0.01" value="0" required>

        <button type="submit">Baajata Herrebi</button>
    </form>

    {% if buaan %}
    <div class="result">
        <h3>Bu'aa Karooraa</h3>
        <p><b>Maqaa:</b> {{ buaan.maqaa }}</p>
        <p><b>Baajata waliigalaa:</b>
        {{ "%.2f"|format(buaan.baajata) }}
Birrii</p>
        <p><b>Maallaqa hafe:</b>
        {{ "%.2f"|format(buaan.hafe) }} Birrii</p>
        {% if buaan.hafe < 0 %}
        <p style="color:red">Hubachiisa: Baasiin baajata caaleera.</p>
        {% else %}
        <p style="color:green">Baajanni kee baasii galchite ni danda'a.</p>
        {% endif %}
    </div>
    {% endif %}
</div>
</body>
</html>
"""

@app.route("/", methods=["GET", "POST"])
def karoora():
    buaan = None

    if request.method == "POST":
        try:
            maqaa = request.form["maqaa"].strip()
baajata = float(request.form["baajata"])
            meeshaa = float(request.form["meeshaa"])
            hojjetaa = float(request.form["hojjetaa"])
            biroo = float(request.form["biroo"])

            if (not maqaa or min(
                baajata, meeshaa, hojjetaa, biroo
            ) < 0):
                raise ValueError

            baasii = meeshaa + hojjetaa + biroo

            buaan = {
                "maqaa": maqaa,
                "baajata": baajata,
                "baasii": baasii,
                "hafe": baajata - baasii
            }
        except (ValueError, TypeError):
            return "Maaloo odeeffannoo sirrii galchi.", 400

    return render_template_string(HTML, buaan=buaan)
if __name__ == "__main__":
    app.run(debug=True)
